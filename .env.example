# Copy this file to .env and fill in your own values. Never commit or share .env.

# Sectors (https://sectors.app/api). The raw key: no "Bearer" prefix.
SECTORS_API_KEY=your-sectors-api-key-here
SECTORS_BASE_URL=https://api.sectors.app/v2
SECTORS_MCP_URL=https://sectors-mcp.supertype.ai/mcp

# OpenAI model (Days 1-2), used through Pydantic AI. Your trainer gives you the key and the endpoint URL.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_URL=https://your-openai-compatible-endpoint/v1
OPENAI_MODEL=gpt-6.1-sol

# Hide Pydantic AI's start-up banner in notebooks and scripts.
PYDANTIC_AI_NO_BANNER=1

# Module 7.5 (optional): image generation (https://magichour.ai) and your e-mail for the Gmail test.
# Gmail also needs credentials.json in this folder (from your trainer); the first run saves token.json.
MAGIC_API_KEY=your-magic-hour-api-key-here
MY_EMAIL=you@example.com

# Only if the OCBC network needs them (ask IT):
# HTTPS_PROXY=http://proxy.example:8080
# REQUESTS_CA_BUNDLE=C:/path/to/ocbc-ca-bundle.pem
# SSL_CERT_FILE=C:/path/to/ocbc-ca-bundle.pem
# If huggingface.co is blocked, ask IT to allow it once: Module 5 downloads the open-source embedding model from there.
